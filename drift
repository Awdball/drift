#!/bin/sh
set -e
cd "$(dirname "$0")"

mkdir -p images

PXE_HOST="${PXE_HOST:-pi@192.168.0.1}"
PXE_DEST="${PXE_DEST:-/data/netboot_assets/drift.efi}"
PXE_SPLIT_DIR="${PXE_SPLIT_DIR:-/data/netboot_assets/drift}"
PXE_URL="${PXE_URL:-http://192.168.0.1:8080/drift.efi}"
PXE_SPLIT_URL="${PXE_SPLIT_URL:-http://192.168.0.1:8080/drift}"

latest_image() {
    ls -1 images 2>/dev/null | sort | tail -n 1
}

next_image() {
    current_date=$(date +%Y%m%d)
    counter=1
    while [ -e "images/drift.${current_date}$(printf %02d $counter).efi" ]; do
        counter=$((counter + 1))
    done
    echo "drift.${current_date}$(printf %02d $counter).efi"
}

fixup_image() {
    current_date=$(date +%Y%m%d)
    counter=1
    while [ -e "images/drift.${current_date}$(printf %02d $((counter + 1))).efi" ]; do
        counter=$((counter + 1))
    done
    echo "drift.${current_date}$(printf %02d $counter).efi"
}

case "$1" in
    sync-host-secrets)
        echo "Syncing host SSH keys, authorized_keys, and zpool.cache into root/..."
        mkdir -p root/etc/ssh root/root/.ssh root/etc/zfs
        if sudo -n test -r /etc/ssh/ssh_host_ed25519_key 2>/dev/null; then
            sudo cp /etc/ssh/ssh_host_ed25519_key root/etc/ssh/ssh_host_ed25519_key
            sudo cp /etc/ssh/ssh_host_ed25519_key.pub root/etc/ssh/ssh_host_ed25519_key.pub
            sudo chown "$(id -u):$(id -g)" root/etc/ssh/ssh_host_ed25519_key*
            chmod 600 root/etc/ssh/ssh_host_ed25519_key
        elif [ ! -f root/etc/ssh/ssh_host_ed25519_key ]; then
            echo "Generating new ssh_host_ed25519_key in root/etc/ssh/..."
            ssh-keygen -t ed25519 -N "" -f root/etc/ssh/ssh_host_ed25519_key
        fi

        if [ -f "$HOME/.ssh/authorized_keys" ]; then
            cp "$HOME/.ssh/authorized_keys" root/root/.ssh/authorized_keys
        elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
            cp "$HOME/.ssh/id_ed25519.pub" root/root/.ssh/authorized_keys
        fi
        chmod 600 root/root/.ssh/authorized_keys 2>/dev/null || true

        if [ -f /etc/zfs/zpool.cache ]; then
            cp /etc/zfs/zpool.cache root/etc/zfs/zpool.cache
        fi
        echo "Done. Verify files in root/etc/ssh, root/root/.ssh, and root/etc/zfs."
        ;;
    build)
        if [ "$2" = "--fixup" ]; then
            image=$(fixup_image)
        else
            image=$(next_image)
        fi
        echo "Building UKI image: $image"
        docker run --privileged --rm -i \
            -v "$PWD":/mnt -w /root \
            alpine:edge /mnt/drift-build.sh "/mnt/images/$image"
        ;;
    publish)
        image=$(latest_image)
        if [ -z "$image" ]; then
            echo "No built image found in images/. Run './drift build' first." >&2
            exit 1
        fi
        echo "Uploading images/$image to ${PXE_HOST}:${PXE_DEST}..."
        scp "images/$image" "${PXE_HOST}:${PXE_DEST}.new"
        ssh "${PXE_HOST}" "mkdir -p ${PXE_SPLIT_DIR} && mv ${PXE_DEST}.new ${PXE_DEST}"
        echo "Extracting split kernel/initramfs for iPXE compatibility (BIOS & UEFI)..."
        objcopy -O binary --only-section=.linux "images/$image" /tmp/drift-vmlinuz-lts
        objcopy -O binary --only-section=.initrd "images/$image" /tmp/drift-initramfs-lts
        scp /tmp/drift-vmlinuz-lts "${PXE_HOST}:${PXE_SPLIT_DIR}/vmlinuz-lts.new"
        scp /tmp/drift-initramfs-lts "${PXE_HOST}:${PXE_SPLIT_DIR}/initramfs-lts.new"
        ssh "${PXE_HOST}" "mv ${PXE_SPLIT_DIR}/vmlinuz-lts.new ${PXE_SPLIT_DIR}/vmlinuz-lts && mv ${PXE_SPLIT_DIR}/initramfs-lts.new ${PXE_SPLIT_DIR}/initramfs-lts"
        rm -f /tmp/drift-vmlinuz-lts /tmp/drift-initramfs-lts
        echo "Verifying HTTP PXE endpoints (${PXE_URL} & ${PXE_SPLIT_URL})..."
        curl -fsSI "${PXE_URL}"
        curl -fsSI "${PXE_SPLIT_URL}/vmlinuz-lts"
        curl -fsSI "${PXE_SPLIT_URL}/initramfs-lts"
        echo "Published $image to ${PXE_URL} and ${PXE_SPLIT_URL}/"
        ;;
    qemu)
        image=$(latest_image)
        if [ -z "$image" ]; then
            echo "No built image found in images/. Run './drift build' first." >&2
            exit 1
        fi
        echo "Running $image in QEMU (terminate with Ctrl-A X)..."
        OVMF_BIOS="/usr/share/edk2/x64/OVMF.4m.fd"
        [ ! -f "$OVMF_BIOS" ] && OVMF_BIOS="/usr/share/ovmf/x64/OVMF.4m.fd"
        [ ! -f "$OVMF_BIOS" ] && OVMF_BIOS="/usr/share/OVMF/OVMF_CODE.fd"
        qemu-system-x86_64 -enable-kvm -cpu host -m 4G -smp 4 -nographic \
            -bios "$OVMF_BIOS" \
            -kernel "images/$image" \
            -netdev user,id=net0,hostfwd=tcp::2222-:22 \
            -device virtio-net-pci,netdev=net0
        ;;
    deploy)
        image=$(latest_image)
        if [ -z "$image" ]; then
            echo "No built image found in images/. Run './drift build' first." >&2
            exit 1
        fi
        TARGET_ESP="${2:-/boot/efi/EFI/BOOT/BOOTX64.EFI}"
        echo "Deploying images/$image to $TARGET_ESP..."
        if [ -f "$TARGET_ESP" ]; then
            sudo cp "$TARGET_ESP" "${TARGET_ESP}.prev"
        fi
        sudo mkdir -p "$(dirname "$TARGET_ESP")"
        sudo cp "images/$image" "${TARGET_ESP}.new"
        sudo mv "${TARGET_ESP}.new" "$TARGET_ESP"
        sync
        echo "Successfully deployed $image to $TARGET_ESP (backup at ${TARGET_ESP}.prev)"
        ;;
    *)
        echo "Usage: $0 {sync-host-secrets|build [--fixup]|publish|qemu|deploy [esp-path]}"
        exit 1
        ;;
esac

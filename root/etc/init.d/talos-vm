#!/sbin/openrc-run
# shellcheck shell=sh

description="Talos Linux Control Plane KVM Guest"
command="/usr/bin/qemu-system-x86_64"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"

DRIFT_STATE_DIR="${DRIFT_STATE_DIR:-/run/drift}"
VM_STATE_FILE="${DRIFT_STATE_DIR}/talos-vm.env"
BOOTSTRAP_PIDFILE="${DRIFT_STATE_DIR}/talos-bootstrap.pid"

# Defaults (overridden by /etc/conf.d/talos-vm generated by drift-identity)
VM_NAME="${VM_NAME:-talos-cp}"
VM_CPUS="${VM_CPUS:-4}"
VM_MEM="${VM_MEM:-4G}"
VM_MAC="${VM_MAC:-52:54:00:a8:00:fe}"
TAP_IF="tap-talos0"
PASSTHROUGH_GPU="${PASSTHROUGH_GPU:-auto}"
TALOS_SYS_DISK="${TALOS_SYS_DISK:-/dev/disk/by-partlabel/talos-sys}"
PLEX_DB_DISK="${PLEX_DB_DISK:-/dev/disk/by-partlabel/plex-nvme}"
VM_SHUTDOWN_TIMEOUT="${VM_SHUTDOWN_TIMEOUT:-20}"

depend() {
    need net
    after drift-identity zfs-mount nfs sshd
}

write_vm_state() {
    mkdir -p "$DRIFT_STATE_DIR" 2>/dev/null || true
    cat <<EOF > "${VM_STATE_FILE}.tmp"
DRIFT_SCHEMA_VERSION="1"
VM_STATE="${VM_STATE:-unknown}"
VM_NAME="${VM_NAME}"
VM_CPUS="${VM_CPUS}"
VM_MEM="${VM_MEM}"
VM_MAC="${VM_MAC}"
ACCEL_STATE="${ACCEL_STATE:-unknown}"
STORAGE_STATE="${STORAGE_STATE:-unknown}"
STORAGE_SOURCE="${STORAGE_SOURCE:-}"
NVME_STATE="${NVME_STATE:-not_present}"
PLEX_EXPORT_STATE="${PLEX_EXPORT_STATE:-not_present}"
PLEX_DISK_STATE="${PLEX_DISK_STATE:-not_present}"
GPU_STATE="${GPU_STATE:-unknown}"
IGPU_BDF="${IGPU_BDF:-}"
TAP_STATE="${TAP_STATE:-down}"
TAP_IF="${TAP_IF}"
BOOTSTRAP_STATE="${BOOTSTRAP_STATE:-idle}"
BOOTSTRAP_TARGET="${TALOS_TARGET:-}"
QMP_SOCKET="/run/talos-vm.qmp"
CONSOLE_SOCKET="/run/talos-vm.console"
UPDATED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo unknown)"
EOF
    mv "${VM_STATE_FILE}.tmp" "$VM_STATE_FILE" 2>/dev/null || true
}

update_bootstrap_state() {
    BOOTSTRAP_STATE="$1"
    if [ -f "$VM_STATE_FILE" ]; then
        sed -i "s|^BOOTSTRAP_STATE=.*|BOOTSTRAP_STATE=\"${BOOTSTRAP_STATE}\"|" "$VM_STATE_FILE" 2>/dev/null || true
    fi
}

detect_intel_igpu() {
    if [ "${PASSTHROUGH_GPU}" = "disable" ] || [ "${PASSTHROUGH_GPU}" = "none" ]; then
        GPU_STATE="disabled"
        return 1
    fi

    # Explicit BDF provided
    if [ -n "${PASSTHROUGH_GPU}" ] && [ "${PASSTHROUGH_GPU}" != "auto" ]; then
        if [ -d "/sys/bus/pci/devices/${PASSTHROUGH_GPU}" ]; then
            IGPU_BDF="${PASSTHROUGH_GPU}"
            return 0
        fi
        GPU_STATE="not_present"
        return 1
    fi

    # Auto-scan for Intel display controller (vendor 0x8086, class 0x0300.. or 0x0380..)
    for dev_path in /sys/bus/pci/devices/*; do
        [ -e "$dev_path/vendor" ] || continue
        v=$(cat "$dev_path/vendor" 2>/dev/null)
        c=$(cat "$dev_path/class" 2>/dev/null)
        if [ "$v" = "0x8086" ]; then
            case "$c" in
                0x0300*|0x0380*)
                    IGPU_BDF=$(basename "$dev_path")
                    return 0
                    ;;
            esac
        fi
    done
    GPU_STATE="not_present"
    return 1
}

bind_igpu_vfio() {
    [ -n "$IGPU_BDF" ] || return 1

    # Fast-path idempotency: if already bound to vfio-pci, do not unbind/rebind
    current_driver=$(basename "$(readlink "/sys/bus/pci/devices/${IGPU_BDF}/driver" 2>/dev/null)" 2>/dev/null)
    if [ "$current_driver" = "vfio-pci" ]; then
        GPU_STATE="bound_vfio"
        return 0
    fi

    # Verify IOMMU group exists before unbinding host display consoles
    if [ ! -e "/sys/bus/pci/devices/${IGPU_BDF}/iommu_group" ]; then
        ewarn "Intel GPU (${IGPU_BDF}) has no active IOMMU group; continuing headless without VFIO passthrough"
        GPU_STATE="iommu_unavailable"
        return 1
    fi

    for vt in /sys/class/vtconsole/vtcon*; do
        [ -e "$vt/bind" ] && echo 0 > "$vt/bind" 2>/dev/null || true
    done
    echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
    echo simple-framebuffer.0 > /sys/bus/platform/drivers/simple-framebuffer/unbind 2>/dev/null || true

    if [ -e "/sys/bus/pci/devices/${IGPU_BDF}/driver" ]; then
        echo "${IGPU_BDF}" > "/sys/bus/pci/devices/${IGPU_BDF}/driver/unbind" 2>/dev/null || true
    fi
    echo "vfio-pci" > "/sys/bus/pci/devices/${IGPU_BDF}/driver_override" 2>/dev/null || true
    echo "${IGPU_BDF}" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null || true

    driver=$(basename "$(readlink "/sys/bus/pci/devices/${IGPU_BDF}/driver" 2>/dev/null)" 2>/dev/null)
    if [ "$driver" = "vfio-pci" ]; then
        GPU_STATE="bound_vfio"
        einfo "Successfully bound Intel GPU (${IGPU_BDF}) to vfio-pci"
        return 0
    else
        echo "" > "/sys/bus/pci/devices/${IGPU_BDF}/driver_override" 2>/dev/null || true
        GPU_STATE="bind_failed_headless"
        ewarn "Could not bind ${IGPU_BDF} to vfio-pci; continuing headless without GPU passthrough"
        return 1
    fi
}

ensure_nvme_carrier_and_plex_export() {
    NVME_STATE="not_present"
    PLEX_EXPORT_STATE="not_present"

    if [ -b /dev/nvme0n1p2 ]; then
        # Never mount /dev/nvme0n1p2 as a filesystem if it IS the raw Talos block partition
        real_nvme=$(readlink -f /dev/nvme0n1p2 2>/dev/null || echo "/dev/nvme0n1p2")
        real_sys=$(readlink -f "${TALOS_SYS_DISK}" 2>/dev/null || echo "${TALOS_SYS_DISK}")
        real_label=$(readlink -f /dev/disk/by-partlabel/talos-sys 2>/dev/null || echo "")

        if [ "$real_nvme" = "$real_sys" ] || [ "$real_nvme" = "$real_label" ]; then
            NVME_STATE="raw_talos_partition"
            return 0
        fi

        mkdir -p /mnt/nvme
        if mountpoint -q /mnt/nvme || mount -o noatime /dev/nvme0n1p2 /mnt/nvme 2>/dev/null; then
            NVME_STATE="mounted"
            if [ -d /mnt/nvme/plex/config ]; then
                mkdir -p /plex/config
                if mountpoint -q /plex/config || mount --bind /mnt/nvme/plex/config /plex/config 2>/dev/null; then
                    exportfs -ra 2>/dev/null || true
                    PLEX_EXPORT_STATE="bound_exported"
                fi
            fi
        else
            NVME_STATE="mount_skipped"
        fi
    fi
}

select_system_storage() {
    SYS_DRIVE_ARGS=""
    STORAGE_STATE="unknown"
    STORAGE_SOURCE=""

    if [ -b "${TALOS_SYS_DISK}" ]; then
        STORAGE_STATE="persistent_block"
        STORAGE_SOURCE="${TALOS_SYS_DISK}"
        SYS_DRIVE_ARGS="-drive file=${TALOS_SYS_DISK},format=raw,if=none,id=sysdisk,cache=unsafe,aio=threads,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    elif [ -f "${TALOS_SYS_DISK}" ]; then
        STORAGE_STATE="persistent_image"
        STORAGE_SOURCE="${TALOS_SYS_DISK}"
        img_fmt="raw"
        case "${TALOS_SYS_DISK}" in
            *.qcow2) img_fmt="qcow2" ;;
        esac
        SYS_DRIVE_ARGS="-drive file=${TALOS_SYS_DISK},format=${img_fmt},if=none,id=sysdisk,cache=unsafe,aio=threads,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    elif [ -b /dev/disk/by-partlabel/talos-sys ]; then
        STORAGE_STATE="persistent_block"
        STORAGE_SOURCE="/dev/disk/by-partlabel/talos-sys"
        SYS_DRIVE_ARGS="-drive file=/dev/disk/by-partlabel/talos-sys,format=raw,if=none,id=sysdisk,cache=unsafe,aio=threads,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    elif [ -f /mnt/nvme/talos-hv-sys.raw ]; then
        STORAGE_STATE="persistent_image"
        STORAGE_SOURCE="/mnt/nvme/talos-hv-sys.raw"
        SYS_DRIVE_ARGS="-drive file=/mnt/nvme/talos-hv-sys.raw,format=raw,if=none,id=sysdisk,cache=unsafe,aio=threads,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    else
        STORAGE_STATE="ephemeral_qcow2"
        STORAGE_SOURCE="/tmp/talos-ephemeral.qcow2"
        if [ ! -f /tmp/talos-ephemeral.qcow2 ] || [ "${RESET_EPHEMERAL:-0}" = "1" ]; then
            ewarn "No persistent Talos disk found; creating non-destructive ephemeral disk /tmp/talos-ephemeral.qcow2"
            qemu-img create -f qcow2 /tmp/talos-ephemeral.qcow2 20G >/dev/null
        else
            einfo "Reusing existing ephemeral disk /tmp/talos-ephemeral.qcow2"
        fi
        SYS_DRIVE_ARGS="-drive file=/tmp/talos-ephemeral.qcow2,format=qcow2,if=none,id=sysdisk,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    fi
}

select_hypervisor_accel() {
    if [ -c /dev/kvm ]; then
        ACCEL_STATE="kvm"
        MACHINE_ARGS="-machine q35,accel=kvm,kernel-irqchip=split -cpu host,migratable=off"
        if [ -c /dev/vhost-net ]; then
            VHOST_OPT="vhost=on"
        else
            VHOST_OPT="vhost=off"
        fi
    else
        ACCEL_STATE="tcg"
        MACHINE_ARGS="-machine q35,accel=tcg -cpu max"
        VHOST_OPT="vhost=off"
        ewarn "/dev/kvm not available; falling back to TCG software emulation"
    fi
}

start_pre() {
    VM_STATE="starting"
    BOOTSTRAP_STATE="idle"

    # 1. Mount NVMe carrier and bind-mount Plex NFS export if present
    ensure_nvme_carrier_and_plex_export

    # 2. Guardrail: Skip nested VM launch if running inside a small (< 8 GiB RAM) test VM with no persistent storage
    mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
    if [ "${FORCE_VM:-0}" != "1" ] && [ "${mem_kb:-0}" -lt 8000000 ] && [ ! -b "${TALOS_SYS_DISK}" ] && [ ! -f "${TALOS_SYS_DISK}" ] && [ ! -b /dev/disk/by-partlabel/talos-sys ] && [ ! -f /mnt/nvme/talos-hv-sys.raw ]; then
        ewarn "Small test VM environment detected (< 8 GiB RAM and no persistent talos-sys disk); skipping nested Talos VM launch."
        VM_STATE="skipped"
        STORAGE_STATE="skipped_small_host"
        write_vm_state
        return 1
    fi

    # 3. Select persistent block, persistent image, or ephemeral QCOW2 storage
    select_system_storage

    # 4. Select optional dedicated Plex NVMe block device passthrough
    PLEX_DRIVE_ARGS=""
    PLEX_DISK_STATE="not_present"
    if [ -b "${PLEX_DB_DISK}" ]; then
        PLEX_DISK_STATE="passthrough_block"
        PLEX_DRIVE_ARGS="-drive file=${PLEX_DB_DISK},format=raw,if=none,id=plexdisk,cache=none,aio=native,discard=unmap -device virtio-blk-pci,drive=plexdisk,serial=plex-nvme"
    fi

    # 5. Select KVM vs TCG acceleration
    select_hypervisor_accel

    # 6. Probe and bind Intel iGPU to vfio-pci if available
    IGPU_ARGS=""
    if detect_intel_igpu; then
        if bind_igpu_vfio; then
            IGPU_ARGS="-device vfio-pci,host=${IGPU_BDF}"
        fi
    fi

    # 7. Configure Virtual TAP network interface and lock bridge MAC
    if ! ip link show "${TAP_IF}" >/dev/null 2>&1; then
        ip tuntap add dev "${TAP_IF}" mode tap
    fi
    ip link set "${TAP_IF}" master br0
    ip link set "${TAP_IF}" up
    TAP_STATE="bridged_up"

    if [ -n "${PHYS_MAC}" ]; then
        ip link set dev br0 address "${PHYS_MAC}" 2>/dev/null || true
    fi

    OVMF_BIOS="/usr/share/ovmf/x64/OVMF.4m.fd"
    [ ! -f "$OVMF_BIOS" ] && OVMF_BIOS="/usr/share/OVMF/OVMF.fd"

    command_args="
        -name ${VM_NAME}
        ${MACHINE_ARGS}
        -smp ${VM_CPUS}
        -m ${VM_MEM}
        -bios ${OVMF_BIOS}
        -display none
        -chardev socket,id=char0,path=/run/talos-vm.console,server=on,wait=off,logfile=/var/log/talos-vm.log
        -serial chardev:char0
        -rtc base=utc,clock=host
        -device virtio-rng-pci
        -netdev tap,id=net0,ifname=${TAP_IF},script=no,downscript=no,${VHOST_OPT}
        -device virtio-net-pci,netdev=net0,mac=${VM_MAC},bootindex=2
        ${SYS_DRIVE_ARGS}
        ${PLEX_DRIVE_ARGS}
        ${IGPU_ARGS}
        -qmp unix:/run/talos-vm.qmp,server,nowait
    "

    VM_STATE="running"
    write_vm_state
}

start_post() {
    # Determine safe Talos bootstrap target IP (never default unknown nodes to hv's production IP!)
    TALOS_TARGET="${TALOS_VM_IP:-}"
    if [ -z "$TALOS_TARGET" ]; then
        case "${NODE_NAME}" in
            hv) TALOS_TARGET="192.168.10.10" ;;
            steam-worker) TALOS_TARGET="192.168.10.11" ;;
        esac
    fi

    if [ ! -x /usr/local/bin/talosctl ] || [ ! -f "/etc/talos/${NODE_NAME}-controlplane.yaml" ]; then
        update_bootstrap_state "skipped_no_config"
        return 0
    fi

    if [ -z "$TALOS_TARGET" ]; then
        update_bootstrap_state "skipped_unknown_target"
        return 0
    fi

    update_bootstrap_state "probing"
    (
        for _ in $(seq 1 60); do
            if /usr/local/bin/talosctl -n "${TALOS_TARGET}" version >/dev/null 2>&1; then
                update_bootstrap_state "already_configured"
                rm -f "$BOOTSTRAP_PIDFILE"
                exit 0
            fi
            if /usr/local/bin/talosctl apply-config --insecure -n "${TALOS_TARGET}" --file "/etc/talos/${NODE_NAME}-controlplane.yaml" 2>/dev/null; then
                update_bootstrap_state "config_applied"
                rm -f "$BOOTSTRAP_PIDFILE"
                exit 0
            fi
            sleep 2
        done
        update_bootstrap_state "timeout"
        rm -f "$BOOTSTRAP_PIDFILE"
    ) &
    echo $! > "$BOOTSTRAP_PIDFILE"
}

stop_pre() {
    VM_STATE="shutting_down"
    write_vm_state

    # Cancel any in-flight bootstrap loop
    if [ -f "$BOOTSTRAP_PIDFILE" ]; then
        bpid=$(cat "$BOOTSTRAP_PIDFILE" 2>/dev/null)
        [ -n "$bpid" ] && kill "$bpid" 2>/dev/null || true
        rm -f "$BOOTSTRAP_PIDFILE"
    fi

    if [ -S /run/talos-vm.qmp ]; then
        einfo "Sending ACPI system_powerdown to ${VM_NAME} via QMP..."
        (
            printf '{"execute":"qmp_capabilities"}\n'
            sleep 0.2 2>/dev/null || sleep 1
            printf '{"execute":"system_powerdown"}\n'
        ) | nc -w 2 -U /run/talos-vm.qmp >/dev/null 2>&1 || true

        # Poll for graceful QEMU exit before supervise-daemon sends SIGTERM
        qemu_pid=$(pgrep -f "^/usr/bin/qemu-system-x86_64.*-name ${VM_NAME}" 2>/dev/null | head -n 1)
        [ -z "$qemu_pid" ] && qemu_pid=$(pidof qemu-system-x86_64 2>/dev/null | awk '{print $1}')
        if [ -n "$qemu_pid" ]; then
            waited=0
            while [ "$waited" -lt "${VM_SHUTDOWN_TIMEOUT}" ] && kill -0 "$qemu_pid" 2>/dev/null; do
                sleep 1
                waited=$((waited + 1))
            done
        fi
    fi
}

stop_post() {
    ip link del "${TAP_IF}" 2>/dev/null || true
    TAP_STATE="down"
    VM_STATE="stopped"
    write_vm_state
}

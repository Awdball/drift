#!/sbin/openrc-run
# shellcheck shell=sh

description="Talos Linux Control Plane KVM Guest"
command="/usr/bin/qemu-system-x86_64"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"

# Defaults (overridden by /etc/conf.d/talos-vm generated by drift-identity)
VM_NAME="${VM_NAME:-talos-cp}"
VM_CPUS="${VM_CPUS:-10}"
VM_MEM="${VM_MEM:-22G}"
VM_MAC="${VM_MAC:-52:54:00:a8:00:fe}"
TAP_IF="tap-talos0"
IGPU_BDF="0000:00:02.0"

# Strictly use GPT partition labels so raw partitions (like /dev/nvme0n1p2) are NEVER touched accidentally
TALOS_SYS_DISK="/dev/disk/by-partlabel/talos-sys"
PLEX_DB_DISK="/dev/disk/by-partlabel/plex-nvme"

depend() {
    need net
    after drift-identity zfs-mount nfs sshd
}

has_intel_igpu() {
    [ -e "/sys/bus/pci/devices/${IGPU_BDF}/vendor" ] || return 1
    vendor=$(cat "/sys/bus/pci/devices/${IGPU_BDF}/vendor" 2>/dev/null)
    device=$(cat "/sys/bus/pci/devices/${IGPU_BDF}/device" 2>/dev/null)
    [ "$vendor" = "0x8086" ] && [ "$device" = "0x3e92" ]
}

bind_igpu_vfio() {
    for vt in /sys/class/vtconsole/vtcon*; do
        [ -e "$vt/bind" ] && echo 0 > "$vt/bind" 2>/dev/null || true
    done
    echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
    echo simple-framebuffer.0 > /sys/bus/platform/drivers/simple-framebuffer/unbind 2>/dev/null || true

    if [ -e "/sys/bus/pci/devices/${IGPU_BDF}/driver" ]; then
        echo "${IGPU_BDF}" > "/sys/bus/pci/devices/${IGPU_BDF}/driver/unbind" 2>/dev/null || true
    fi
    echo "vfio-pci" > "/sys/bus/pci/devices/${IGPU_BDF}/driver_override"
    echo "${IGPU_BDF}" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null || true
}

start_pre() {
    # Skip nested VM launch if running inside a small (< 8 GiB RAM) local QEMU test VM
    mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    if [ "${mem_kb:-0}" -lt 8000000 ] && [ ! -b "${TALOS_SYS_DISK}" ]; then
        ewarn "Small test VM environment detected (< 8 GiB RAM and no ${TALOS_SYS_DISK}); skipping nested Talos VM launch."
        return 1
    fi

    # Scale VM_MEM and VM_CPUS automatically if host has less than 28 GiB RAM
    if [ "${mem_kb:-0}" -lt 28000000 ]; then
        VM_MEM="$((mem_kb / 1024 * 60 / 100))M"
    fi
    host_cpus=$(nproc 2>/dev/null || echo 4)
    if [ "$host_cpus" -lt 12 ]; then
        VM_CPUS=$((host_cpus > 2 ? host_cpus - 2 : host_cpus))
    fi

    if [ -b "${TALOS_SYS_DISK}" ]; then
        SYS_DRIVE_ARGS="-drive file=${TALOS_SYS_DISK},format=raw,if=none,id=sysdisk,cache=none,aio=native,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    else
        ewarn "GPT label ${TALOS_SYS_DISK} not found; using non-destructive ephemeral disk /tmp/talos-ephemeral.qcow2"
        qemu-img create -f qcow2 /tmp/talos-ephemeral.qcow2 20G >/dev/null
        SYS_DRIVE_ARGS="-drive file=/tmp/talos-ephemeral.qcow2,format=qcow2,if=none,id=sysdisk,discard=unmap -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1"
    fi

    PLEX_DRIVE_ARGS=""
    if [ -b "${PLEX_DB_DISK}" ]; then
        PLEX_DRIVE_ARGS="-drive file=${PLEX_DB_DISK},format=raw,if=none,id=plexdisk,cache=none,aio=native,discard=unmap -device virtio-blk-pci,drive=plexdisk,serial=plex-nvme"
    fi

    IGPU_ARGS=""
    if has_intel_igpu; then
        bind_igpu_vfio
        IGPU_ARGS="-device vfio-pci,host=${IGPU_BDF}"
    fi

    if ! ip link show "${TAP_IF}" >/dev/null 2>&1; then
        ip tuntap add dev "${TAP_IF}" mode tap
    fi
    ip link set "${TAP_IF}" master br0
    ip link set "${TAP_IF}" up

    OVMF_BIOS="/usr/share/ovmf/x64/OVMF.4m.fd"
    [ ! -f "$OVMF_BIOS" ] && OVMF_BIOS="/usr/share/OVMF/OVMF.fd"

    command_args="
        -name ${VM_NAME}
        -machine q35,accel=kvm,kernel-irqchip=split
        -cpu host,migratable=off
        -smp ${VM_CPUS}
        -m ${VM_MEM}
        -bios ${OVMF_BIOS}
        -display none
        -chardev socket,id=char0,path=/run/talos-vm.console,server=on,wait=off,logfile=/var/log/talos-vm.log
        -serial chardev:char0
        -rtc base=utc,clock=host
        -device virtio-rng-pci
        -netdev tap,id=net0,ifname=${TAP_IF},script=no,downscript=no,vhost=on
        -device virtio-net-pci,netdev=net0,mac=${VM_MAC},bootindex=2
        ${SYS_DRIVE_ARGS}
        ${PLEX_DRIVE_ARGS}
        ${IGPU_ARGS}
        -qmp unix:/run/talos-vm.qmp,server,nowait
    "
}

stop() {
    ebegin "Sending ACPI powerdown to Talos VM"
    if [ -S /run/talos-vm.qmp ]; then
        printf '{"execute":"qmp_capabilities"}\n{"execute":"system_powerdown"}\n' \
            | nc -U /run/talos-vm.qmp >/dev/null 2>&1 || true
        i=0
        while [ $i -lt 60 ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
    fi
    default_stop
    ip link del "${TAP_IF}" 2>/dev/null || true
    eend $?
}

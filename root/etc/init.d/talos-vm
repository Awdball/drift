#!/sbin/openrc-run
# shellcheck shell=sh

description="Talos Linux Control Plane KVM Guest"
command="/usr/bin/qemu-system-x86_64"
supervisor="supervise-daemon"
pidfile="/run/${RC_SVCNAME}.pid"

# VM Resources: 10 vCPUs (of 12 threads), 22 GiB RAM
VM_CPUS="10"
VM_MEM="22G"
VM_MAC="52:54:00:a8:00:fe"
TAP_IF="tap-talos0"
IGPU_BDF="0000:00:02.0"

# Raw NVMe partitions passed directly for native microsecond I/O
TALOS_SYS_DISK="/dev/nvme0n1p2"
PLEX_DB_DISK="/dev/nvme0n1p3"

command_args="
    -name talos-cp-hv
    -machine q35,accel=kvm,kernel-irqchip=split
    -cpu host,migratable=off
    -smp ${VM_CPUS},sockets=1,cores=5,threads=2
    -m ${VM_MEM}
    -bios /usr/share/ovmf/x64/OVMF.4m.fd
    -nographic
    -serial mon:stdio
    -rtc base=utc,clock=host
    -device virtio-rng-pci
    -netdev tap,id=net0,ifname=${TAP_IF},script=no,downscript=no,vhost=on
    -device virtio-net-pci,netdev=net0,mac=${VM_MAC},bootindex=2
    -drive file=${TALOS_SYS_DISK},format=raw,if=none,id=sysdisk,cache=none,aio=native,discard=unmap
    -device virtio-blk-pci,drive=sysdisk,serial=talos-sys,bootindex=1
    -drive file=${PLEX_DB_DISK},format=raw,if=none,id=plexdisk,cache=none,aio=native,discard=unmap
    -device virtio-blk-pci,drive=plexdisk,serial=plex-nvme
    -device vfio-pci,host=${IGPU_BDF}
    -qmp unix:/run/talos-vm.qmp,server,nowait
"

depend() {
    need net nfs zfs-mount
    after keepalived sshd
}

bind_igpu_vfio() {
    # Detach virtual console & EFI framebuffer so iGPU can bind cleanly to vfio-pci.
    # Leaving vfio-pci unbound until this point keeps the physical HDMI display active
    # during UEFI, initramfs, network bring-up, SSH, and ZFS import.
    for vt in /sys/class/vtconsole/vtcon*; do
        [ -e "$vt/bind" ] && echo 0 > "$vt/bind" 2>/dev/null || true
    done
    echo efi-framebuffer.0 > /sys/bus/platform/drivers/efi-framebuffer/unbind 2>/dev/null || true
    echo simple-framebuffer.0 > /sys/bus/platform/drivers/simple-framebuffer/unbind 2>/dev/null || true

    if [ -e "/sys/bus/pci/devices/${IGPU_BDF}/driver" ]; then
        echo "${IGPU_BDF}" > "/sys/bus/pci/devices/${IGPU_BDF}/driver/unbind" 2>/dev/null || true
    fi
    echo "vfio-pci" > "/sys/bus/pci/devices/${IGPU_BDF}/driver_override"
    echo "${IGPU_BDF}" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null || true
}

start_pre() {
    if ! ip link show "${TAP_IF}" >/dev/null 2>&1; then
        ip tuntap add dev "${TAP_IF}" mode tap
    fi
    ip link set "${TAP_IF}" master br0
    ip link set "${TAP_IF}" up

    bind_igpu_vfio
}

stop() {
    ebegin "Sending ACPI powerdown to Talos VM"
    if [ -S /run/talos-vm.qmp ]; then
        printf '{"execute":"qmp_capabilities"}\n{"execute":"system_powerdown"}\n' \
            | nc -U /run/talos-vm.qmp >/dev/null 2>&1 || true
        # Wait up to 60s for Talos to cleanly unmount /var and stop etcd
        i=0
        while [ $i -lt 60 ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; do
            sleep 1
            i=$((i + 1))
        done
    fi
    default_stop
    ip link del "${TAP_IF}" 2>/dev/null || true
    eend $?
}
